# =============================================================================
# engine/.env.example
# Copy to .env and fill in real values before running.
# =============================================================================

# --- Database ---
# PostgreSQL connection string used by the engine for the audit trail.
DATABASE_URL=postgresql://gridnexus:gridnexus_dev@localhost:5432/gridnexus

# --- Redis ---
# Redis connection string used for BullMQ task queue communication.
REDIS_URL=redis://localhost:6379/0

# --- Authentication (JWT) ---
# Secret key for signing JWT tokens. MUST be changed in production.
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-production
JWT_EXPIRE_HOURS=24

# --- LLM Provider ---
# API key for the LLM provider (e.g., OpenAI) used by LangChain negotiation agents.
# Leave blank to use the built-in local mock (no network calls).
LLM_API_KEY=

# --- Server ---
# Host and port for the FastAPI uvicorn server.
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8000
