# =============================================================================
# broker/.env.example
# Copy to .env and fill in real values before running.
# =============================================================================

# --- Database ---
# PostgreSQL connection string for the immutable audit trail.
DATABASE_URL=postgresql://gridnexus:gridnexus_dev@localhost:5432/gridnexus

# --- Redis ---
# Redis connection string for BullMQ task queue.
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---
# Secret key for signing JWT tokens. Must match the engine's JWT_SECRET.
JWT_SECRET=change-me-to-a-random-secret

# Shared HS256 secret used to verify agent JWTs presented to the /negotiate
# WebSocket namespace. Must match ENGINE_JWT_SECRET set in engine/.env.
ENGINE_JWT_SECRET=change-me-to-a-different-random-secret-min-32-chars

# --- CORS ---
# Comma-separated list of allowed cross-origin URLs.
# Leave empty to deny ALL cross-origin requests (recommended for production).
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# --- Server ---
# Port the Express broker listens on.
BROKER_PORT=3000

# --- Engine ---
# URL of the engine service for the broker to call into Layer 1.
ENGINE_URL=http://localhost:8000

# --- Encryption ---
# 32-byte hex string (64 characters) for AES-256-GCM encryption of microgrid hidden fields.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
