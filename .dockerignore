# .dockerignore
# Exclude all secrets, environment files, local caches, and IDE artifacts
.env
.env.*
!.env.example
*.local

# Version control & OS
.git/
.gitignore
.DS_Store
Thumbs.db

# Python caches & virtualenvs
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.coverage
coverage.xml
.ruff_cache/
.mypy_cache/

# Node caches & modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# Build outputs
dist/
build/
*.tsbuildinfo
test-results/
playwright-report/

# Docs & Scratch
docs/
artifacts/
scratch/
*.md
*.png
*.svg
# Large local datasets and demo recordings are runtime mounts, never image inputs
opsd-household_data-2020-04-15/
india_spectral_tmy.h5
*.mp4
for ui/

# Keep assets referenced by the shipped UI in its build context.
!command-center/public/**/*.png
!command-center/public/**/*.svg
!command-center/public/**/*.mp4
